{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Zephyr: Build firmware",
      "type": "process",
      "command": "${env:HOME}/zephyrproject/.venv/bin/west",
      "args": [
        "build",
        "-d",
        "${workspaceFolder}/build",
        "-b",
        "stm32f746g_disco",
        "${workspaceFolder}/fcc_app",
        "--",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
      ],
      "options": {
        "cwd": "${env:HOME}/zephyrproject"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Build firmware and refresh IntelliSense compile commands in workspace/build."
    },
    {
      "label": "Host: Configure UART tests",
      "type": "process",
      "command": "/opt/homebrew/bin/cmake",
      "args": [
        "-S",
        "${workspaceFolder}/fcc_app/tests/test_uart_rx",
        "-B",
        "${workspaceFolder}/build_uart_rx",
        "-G",
        "Ninja",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DCMAKE_C_COMPILER=/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/clang",
        "-DCMAKE_OSX_SYSROOT=/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk"
      ],
      "problemMatcher": [],
      "detail": "Refresh host test compile commands; firmware and host mocks use separate configurations."
    },
    {
      "label": "Host: Configure STATUS tests",
      "type": "process",
      "command": "/opt/homebrew/bin/cmake",
      "args": [
        "-S",
        "${workspaceFolder}/fcc_app/tests/test_frame_handler",
        "-B",
        "${workspaceFolder}/build_frame_handler",
        "-G",
        "Ninja",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DCMAKE_C_COMPILER=/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/clang",
        "-DCMAKE_OSX_SYSROOT=/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk"
      ],
      "problemMatcher": [],
      "detail": "Refresh STATUS handler host test compile commands."
    },
    {
      "label": "Host: Configure TX tests",
      "type": "process",
      "command": "/opt/homebrew/bin/cmake",
      "args": [
        "-S",
        "${workspaceFolder}/fcc_app/tests/test_uart_tx",
        "-B",
        "${workspaceFolder}/build_uart_tx",
        "-G",
        "Ninja",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DCMAKE_C_COMPILER=/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/clang",
        "-DCMAKE_OSX_SYSROOT=/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk"
      ],
      "problemMatcher": [],
      "detail": "Refresh TX host test compile commands."
    },
    {
      "label": "Host: Configure Tracking tests",
      "type": "process",
      "command": "/opt/homebrew/bin/cmake",
      "args": [
        "-S",
        "${workspaceFolder}/fcc_app/tests/test_kalman",
        "-B",
        "${workspaceFolder}/build_tracking",
        "-G",
        "Ninja",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DCMAKE_C_COMPILER=/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/clang",
        "-DCMAKE_OSX_SYSROOT=/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk",
        "-DTRACK_TEST_HOST=ON"
      ],
      "problemMatcher": [],
      "detail": "Refresh Tracking host test compile commands."
    }
  ]
}
