/*
 * stm32f746g_disco.overlay
 *
 * HIL data link: USART6 on PC6 (TX) / PC7 (RX), 115200 8N1.
 * These pins are used with the external 3.3 V USB-UART adapter.
 *
 * Note: older comments in this project referenced PG9/PG14 (Arduino D0/D1),
 * but the working Zephyr pinctrl configuration for this board uses PC6/PC7.
 * USART1 remains available for the Zephyr console through the board's ST-Link VCP.
 */

&usart6 {
    pinctrl-0 = <&usart6_tx_pc6 &usart6_rx_pc7>;
    pinctrl-names = "default";
    current-speed = <115200>;
    status = "okay";
};
