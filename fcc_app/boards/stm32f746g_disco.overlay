/*
 * stm32f746g_disco.overlay
 *
 * HIL 통신용 USART6 활성화.
 * 하드웨어 연결: Arduino 헤더 D0(PG9, RX) / D1(PG14, TX)
 * → USB-UART 어댑터를 연결하고 PC에서 /dev/ttyUSB0 으로 접근.
 *
 * USART1(ST-Link VCP, /dev/ttyACM0)은 Zephyr 콘솔(printk)에 계속 사용.
 */

&usart6 {
    pinctrl-0 = <&usart6_tx_pc6 &usart6_rx_pc7>;
    pinctrl-names = "default";
    current-speed = <115200>;
    status = "okay";
};
