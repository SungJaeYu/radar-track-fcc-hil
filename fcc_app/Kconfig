mainmenu "Radar tracking firmware"

# Zephyr platform, board, driver, and kernel configuration definitions.
# The build command selects the board; its defconfig supplies board defaults.
source "Kconfig.zephyr"

# Application tuning options; select values in prj.conf.
menu "Radar application settings"

# RX buffer recovery policy.
choice RADAR_RX_OVERFLOW_POLICY
    prompt "RX overflow recovery policy"
    default RADAR_RX_OVERFLOW_DRAIN

config RADAR_RX_OVERFLOW_DRAIN
    bool "Drain buffered frames"
    help
        Process frames that can be completed from buffered bytes,
        then discard any remaining partial frame.

config RADAR_RX_OVERFLOW_DISCARD
    bool "Discard all buffered data"
    help
        Discard all buffered bytes and reset partial frame assembly.

endchoice

# Independent timeout limits, expressed in milliseconds.
config RADAR_FRAME_RX_TIMEOUT_MS
    int "Partial frame timeout (ms)"
    range 1 60000
    default 1000
    help
        Reset an incomplete frame when no further byte is processed
        within this interval. Idle parsers are not monitored.

config RADAR_MEASUREMENT_TIMEOUT_MS
    int "Radar measurement timeout (ms)"
    range 1 60000
    default 1000
    help
        Clear the track when no decoded and validated measurement
        is received within this interval. Monitoring starts only
        after the first valid measurement.

# Rectangular measurement gates: maximum absolute errors, not full window widths.
config RADAR_RANGE_GATE_M
    int "Range gate half-width (m)"
    range 1 65535
    default 100
    help
        Accept a measurement only when its absolute range error is at most
        this value in meters. The angular gate must also pass.
        This is a fixed threshold, not a covariance-based gate.

config RADAR_AZIMUTH_GATE_DEG
    int "Azimuth gate half-width (degrees)"
    range 1 180
    default 10
    help
        Maximum absolute wrapped angular error, including the boundary.
        Configuration uses whole degrees; calculations use radians.
        At 180 degrees every finite normalized angular error passes,
        but the range gate still applies.

# Generate per-module log levels and their OFF/ERR/WRN/INF/DBG choices.
# Select a choice in prj.conf or debug.conf; do not assign the derived integer.
# The template depends on LOG and uses LOG_DEFAULT_LEVEL for its Default choice.
menu "Application logging"
module = RADAR_MAIN
module-str = Radar startup
source "subsys/logging/Kconfig.template.log_config"

module = RADAR_UART_RX
module-str = Radar UART RX
source "subsys/logging/Kconfig.template.log_config"

module = RADAR_RX_PROCESSOR
module-str = Radar RX frame processor
source "subsys/logging/Kconfig.template.log_config"

module = RADAR_UART_TX
module-str = Radar UART TX
source "subsys/logging/Kconfig.template.log_config"

module = RADAR_HANDLER
module-str = Radar frame handler
source "subsys/logging/Kconfig.template.log_config"
endmenu

config RADAR_LOG_STRESS_TEST
    bool "Run a bounded log saturation test after boot"
    depends on LOG_MODE_DEFERRED && LOG_PROCESS_THREAD && ASSERT
    default n
    help
        Bench testing only. Generate numbered log bursts once after boot
        to exercise log-buffer exhaustion while UART traffic continues.
        Do not enable in normal firmware. See tests/log_stress/README.md.

endmenu
